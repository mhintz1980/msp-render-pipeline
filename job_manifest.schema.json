{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MSPRenderJobManifest",
  "description": "Schema for MSP deterministic headless CAD rendering and AI grounding jobs",
  "type": "object",
  "required": ["job_id", "package_model", "cad_source", "camera", "livery", "lighting", "output"],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Unique identifier for the render job"
    },
    "package_model": {
      "type": "string",
      "description": "Target MSP dewatering pump model",
      "enum": ["RL300_SAFE", "RL300_OPEN", "RL200_SAFE", "DD4SE_TRAILER", "DD6_SAFE", "DP150_SKID", "HC100_SAFE", "CUSTOM"]
    },
    "cad_source": {
      "type": "object",
      "required": ["file_path"],
      "properties": {
        "file_path": { "type": "string" },
        "format": { "type": "string", "enum": ["glb", "gltf", "step", "obj", "blend"], "default": "glb" },
        "up_axis": { "type": "string", "enum": ["Y", "Z"], "default": "Z" },
        "unit_scale": { "type": "number", "default": 1.0 }
      }
    },
    "camera": {
      "type": "object",
      "required": ["preset"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["P1_FRONT_ISO", "P2_FRONT_ELEVATION", "P3_RIGHT_THREE_QUARTER", "P4_LEFT_THREE_QUARTER", "P5_REAR_THREE_QUARTER", "P6_SIDE_PROFILE", "P7_LOW_HERO", "P8_OVERHEAD_PLAN", "CUSTOM"],
          "description": "Standardized photo studio camera position corresponding to MSP physical photo archives"
        },
        "focal_length_mm": { "type": "number", "default": 50.0 },
        "elevation_deg": { "type": "number" },
        "azimuth_deg": { "type": "number" },
        "target_offset": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "default": [0.0, 0.0, 0.5]
        }
      }
    },
    "livery": {
      "type": "object",
      "required": ["preset"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["msp_standard_yellow", "united_rentals_blue", "sunbelt_green", "herc_rentals_white", "custom"],
          "description": "Standard fleet or client powder coat and decal scheme"
        },
        "body_color_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "body_roughness": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.35 },
        "body_clearcoat": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.25 },
        "frame_color_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#1A1A1A" },
        "frame_roughness": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.55 },
        "decal_pack": { "type": "string", "enum": ["MSP", "UNITED_RENTALS", "NONE"], "default": "MSP" }
      }
    },
    "lighting": {
      "type": "object",
      "required": ["preset"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["studio_white", "studio_dark", "excavation_pit_sunlit", "overcast_industrial", "custom"]
        },
        "intensity_multiplier": { "type": "number", "default": 1.0 },
        "color_temperature_k": { "type": "number", "default": 5500 },
        "hdri_path": { "type": "string" },
        "shadow_catcher": { "type": "boolean", "default": true }
      }
    },
    "output": {
      "type": "object",
      "required": ["width", "height", "engine"],
      "properties": {
        "width": { "type": "integer", "default": 1920 },
        "height": { "type": "integer", "default": 1080 },
        "samples": { "type": "integer", "default": 128 },
        "engine": { "type": "string", "enum": ["CYCLES", "EEVEE"], "default": "CYCLES" },
        "denoiser": { "type": "string", "enum": ["OPENIMAGEDENOISE", "OPTIX", "NONE"], "default": "OPENIMAGEDENOISE" },
        "passes": {
          "type": "object",
          "properties": {
            "beauty": { "type": "boolean", "default": true },
            "alpha_mask": { "type": "boolean", "default": true },
            "depth_map": { "type": "boolean", "default": true },
            "surface_normals": { "type": "boolean", "default": true },
            "contact_shadow": { "type": "boolean", "default": true }
          }
        },
        "output_dir": { "type": "string", "default": "./output" }
      }
    },
    "compositing": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "background_plate": { "type": "string" },
        "ai_environment_prompt": { "type": "string" },
        "shadow_opacity": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.85 },
        "edge_feather_px": { "type": "integer", "default": 1 }
      }
    }
  }
}
