{
  "job_id": "rl300_02_studio-dark",
  "package_model": "RL300_SAFE",
  "_description": "STEP 2 of the demo. Same machine, same camera - but the studio plate is now loaded as the world environment, so the machine is lit by the photograph itself (image-based / HDRI lighting) and then seated on it. Compare against step 1 to see what the environment contributes.",
  "cad_source": {
    "file_path": "cad/RL300-SAFE-photoreal.blend",
    "format": "blend",
    "up_axis": "Z",
    "unit_scale": 1.0
  },
  "camera": {
    "preset": "CUSTOM",
    "focal_length_mm": 85.0,
    "elevation_deg": 11.0,
    "azimuth_deg": 42.0,
    "distance_multiplier": 6.6,
    "target_offset": [
      0.0,
      0.0,
      0.92
    ],
    "depth_of_field": {
      "enabled": true,
      "f_stop": 11.0,
      "blades": 8
    }
  },
  "geometry": {
    "smooth_hardware": false,
    "hide_misplaced_isolators": true
  },
  "livery": {
    "preset": "preserve_existing"
  },
  "lighting": {
    "preset": "studio_dark",
    "intensity_multiplier": 0.7,
