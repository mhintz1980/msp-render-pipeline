{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studiomark:remote-job-result:1",
  "title": "StudioMark remote render result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "request_id", "attempt_id", "status", "failure_code", "compute", "runtime", "timings", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed"]},
    "failure_code": {"type": ["string", "null"], "enum": ["GPU_REQUIRED", "MISSING_OUTPUT", "RENDER_NONZERO_EXIT", "ARTIFACT_HASH_MISMATCH", "CONTRACT_INVALID", null]},
    "compute": {"$ref": "#/$defs/compute"},
    "runtime": {"$ref": "#/$defs/observed_runtime"},
    "timings": {"$ref": "#/$defs/timings"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled_devices", "cpu_in_mix", "gpu_evidence"],
      "properties": {
        "enabled_devices": {
          "type": "array",
          "items": {"$ref": "#/$defs/device"}
        },
        "cpu_in_mix": {"type": "boolean"},
        "gpu_evidence": {"$ref": "#/$defs/gpu_evidence"}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1}
      }
    },
    "gpu_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "samples", "peak_gpu_memory_mib", "sustained_gpu_memory_mib"],
      "properties": {
        "verdict": {"type": "boolean"},
        "samples": {
          "type": "array",
          "items": {"$ref": "#/$defs/gpu_sample"}
        },
        "peak_gpu_memory_mib": {"type": ["number", "null"], "minimum": 0},
        "sustained_gpu_memory_mib": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "gpu_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds", "processes"],
      "properties": {
        "seconds": {"type": "number", "minimum": 0},
        "processes": {"type": "string"}
      }
    },
    "observed_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blender_version", "image", "build"],
      "properties": {
        "blender_version": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1}
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare", "render", "total"],
      "properties": {
        "prepare": {"type": "number", "minimum": 0},
        "render": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0},
        "beauty_render_seconds": {"type": "number", "minimum": 0},
        "matte_render_seconds": {"type": "number", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
