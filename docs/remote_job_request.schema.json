{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studiomark:remote-job-request:1",
  "title": "StudioMark remote render request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "attempt_id", "manifest", "input_assets", "runtime", "render_settings", "expected_artifacts", "require_gpu"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "submission_id": {"type": "string", "minLength": 1},
    "submitted_at": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "manifest": {"$ref": "#/$defs/pinned_document"},
    "input_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/input_asset"}
    },
    "runtime": {"$ref": "#/$defs/request_runtime"},
    "render_settings": {"$ref": "#/$defs/pinned_document"},
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "require_gpu": {"type": "boolean"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pinned_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_json", "sha256"],
      "properties": {
        "canonical_json": {"type": "string", "minLength": 2},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "input_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "request_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blender_version", "image", "build", "device_requirement"],
      "properties": {
        "blender_version": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "device_requirement": {"type": "string", "minLength": 1}
      }
    }
  }
}
